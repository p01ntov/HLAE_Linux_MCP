+std::vector<cs2_mvp::CameraFrame> ReadCameraFrames(const json& input) {
+    try {
+        if (!input.is_array() || input.empty() || input.size() > 1000000) {
+            throw std::invalid_argument("camera_frames must contain 1..1000000 poses");
+        }
+        std::vector<cs2_mvp::CameraFrame> frames;
+        frames.reserve(input.size());
+        for (const auto& value : input) {
+            const auto& position = value.at("position");
+            const auto& angles = value.at("angles");
+            if (!position.is_array() || position.size() != 3 || !angles.is_array() || (angles.size() != 2 && angles.size() != 3)) {
+                throw std::invalid_argument("camera pose requires position[3] and angles[pitch,yaw,optional roll]");
+            }
+            cs2_mvp::CameraFrame frame{{position[0].get<double>(), position[1].get<double>(), position[2].get<double>()},
+                                     {angles[0].get<double>(), angles[1].get<double>(), angles.size()==3 ? angles[2].get<double>() : 0.0}};
+            if (value.contains("fov")) {
+                if (!value.at("fov").is_number()) throw std::invalid_argument("FOV must be a number");
+                frame.fov = value.at("fov").get<double>();
+            }
+            frame.Validate();
+            frames.push_back(frame);
+        }
+        return frames;
+    } catch (const std::exception& error) {
+        Log("CS2_MVP_CAMERA_ERROR invalid camera frames: %s", error.what());
+        environmentAbortRequested=true;
+        return {};
+    }
+}
