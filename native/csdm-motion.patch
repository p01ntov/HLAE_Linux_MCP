+bool OverrideDemoView(void* view) {
+    auto engine = GetEngine();
+    const bool demo = engine != NULL && engine->IsPlayingDemo();
+    if (viewOwnerThread.load() != 0 && viewOwnerThread.load() != gettid()) {
+        if (!viewFault.exchange(true)) Log("CS2_MVP_CAMERA_ERROR main view runs on another thread");
+        return demo;
+    }
+    if (!demo || isQuitting || (!motionTrack.Active() && !viewHoldAfterEnd) || !motionTrack.Applied() || viewFault) return demo;
+    auto* bytes = static_cast<unsigned char*>(view);
+    auto* origin = reinterpret_cast<float*>(bytes + cs2_mvp::LinuxViewPatch::Origin);
+    auto* angles = reinterpret_cast<float*>(bytes + cs2_mvp::LinuxViewPatch::Angles);
+    const float fov = *reinterpret_cast<float*>(bytes + cs2_mvp::LinuxViewPatch::Fov);
+    for (int i=0;i<3;++i) {
+        if (!std::isfinite(origin[i]) || std::abs(origin[i])>1000000.f || !std::isfinite(angles[i])) viewFault=true;
+    }
+    if (!std::isfinite(fov) || fov<1.f || fov>179.f) viewFault=true;
+    if (viewFault) { Log("CS2_MVP_CAMERA_ERROR invalid runtime main-view fields"); return demo; }
+    const bool countView=motionTrack.Active();
+    const auto& pose = motionTrack.LastApplied();
+    if (countView && (viewWrites<2 || (!viewLastLogged && motionTrack.Applied()==motionTrack.Expected()))) {
+        Log("CS2_MVP_VIEW_FRAME index=%zu original=%.3f,%.3f,%.3f planned=%.3f,%.3f,%.3f original_fov=%.3f fov=%.3f",
+            motionTrack.Applied()-1, origin[0],origin[1],origin[2],pose.position[0],pose.position[1],pose.position[2],fov,pose.fov.value_or(fov));
+        if (motionTrack.Applied()==motionTrack.Expected()) viewLastLogged=true;
+    }
+    for (int i=0;i<3;++i) origin[i]=static_cast<float>(pose.position[i]);
+    angles[0]=static_cast<float>(pose.angles[0]); angles[1]=static_cast<float>(pose.angles[1]); angles[2]=static_cast<float>(pose.angles[2]);
+    if (pose.fov) {
+        *reinterpret_cast<float*>(bytes + cs2_mvp::LinuxViewPatch::Fov)=static_cast<float>(*pose.fov);
+        if (countView) {
+            minimumFov=fovWrites ? std::fmin(minimumFov,*pose.fov) : *pose.fov;
+            maximumFov=fovWrites ? std::fmax(maximumFov,*pose.fov) : *pose.fov;
+            ++fovWrites; lastFov=*pose.fov;
+        }
+    }
+    if (countView) ++viewWrites;
+    return demo;
+}
