+bool TryHookFrame(const char* phase) {
+    if (client != NULL) return true;
+    if (factory) client = static_cast<ISource2Client*>(factory("Source2Client002",NULL));
+    if (!client) {
+        const string path=string(Plat_GetGameDirectory())+"/csgo/bin/linuxsteamrt64/libclient.so";
+        void* module=dlopen(path.c_str(),RTLD_NOW|RTLD_NOLOAD);
+        if (module) {
+            auto getInterface=reinterpret_cast<CreateInterfaceFn>(dlsym(module,"CreateInterface"));
+            if (getInterface) client=static_cast<ISource2Client*>(getInterface("Source2Client002",NULL));
+            dlclose(module);
+        }
+    }
+    if (!client) { Log("CS2_MVP_FRAME_HOOK waiting phase=%s",phase); return false; }
+    auto table=*reinterpret_cast<void***>(client);
+    originalFrameStageNotify=reinterpret_cast<FrameStageNotifyFn>(table[36]);
+    PatchVTableEntry(table,36,reinterpret_cast<void*>(&NewFrameStageNotify));
+    Log("CS2_MVP_FRAME_HOOK installed phase=%s",phase);
+    return true;
+}
