+// All camera state is owned by the game thread or protected by sequencesMutex.
+// Applying these console commands is not an OverrideView hook. The existing
+// FRAME_START callback is the frame clock; no wall clock or integer demo tick
+// decides when to advance a camera sample.
+// Internal sidecar actions never pass user JSON to the engine console.
+void InitializeCaptureEnvironment(ISource2EngineToClient* engine) {
+    if(captureEnvironmentBound)return;
+    captureEnvironment.BindScene(cs2_live::ReadSource2SceneCvar,cs2_live::WriteSource2SceneCvar);
+    captureEnvironment.BindAppearance(cs2_live::Source2AppearanceBackend(factory,
+        [engine](const std::string& command){engine->ExecuteClientCmd(0,command.c_str(),true);}));
+    captureEnvironment.BindCosmetics(cs2_live::Source2PlayerCosmetics::Bind(factory,client),
+        cs2_live::Source2WeaponCosmetics::Bind(factory,client),cs2_live::Source2GloveCosmetics::Bind(factory,client));
+    captureEnvironmentBound=true;
+}
+void RestoreCaptureEnvironment(const char* reason) {
+    if(!captureEnvironmentBound)return;
+    captureEnvironment.Restore(environmentTick.load(),reason,[](const std::string& text){LogToFile(text.c_str());});
+    captureEnvironmentBound=false;environmentRecording=false;
+}
+bool RequireRestoreCaptureEnvironment(const char* reason) {
+    try {RestoreCaptureEnvironment(reason);return true;}
+    catch(const std::exception& error) {
+        Log("CS2_MVP_ENVIRONMENT_ERROR restore %s",error.what());
+        environmentAbortRequested=true;return false;
+    }
+}
+
+void ApplyCameraFrame(ISource2EngineToClient* engine, int tick) {
+    const size_t index = motionTrack.Callbacks();
+    const auto& frame = motionTrack.Next();
+    const string command = frame.Command();
+    if (!viewPatch.Installed()) engine->ExecuteClientCmd(0, command.c_str(), true);
+    if (index == 0 || index + 1 == motionTrack.Expected()) {
+        Log("CS2_MVP_CAMERA_FRAME index=%zu tick=%d %s", index, tick, command.c_str());
+    }
+    if (index == motionTrack.Expected()) {
+        Log("CS2_MVP_CAMERA_HOLD expected=%zu tick=%d", motionTrack.Expected(), tick);
+    }
+}
+
+void EndCameraTrack(int tick, const char* reason) {
+    const bool retainView=std::strcmp(reason,"camera_end")==0;
+    if (!retainView) { viewHoldAfterEnd=false; viewOwnerThread=0; }
+    if (!motionTrack.Active()) {
+        return;
+    }
+    Log("CS2_MVP_CAMERA_END applied=%zu expected=%zu callbacks=%zu overflow=%zu tick=%d reason=%s",
+        motionTrack.Applied(), motionTrack.Expected(), motionTrack.Callbacks(),
+        motionTrack.Overflow(), tick, reason);
+    Log("CS2_MVP_VIEW_END writes=%zu fault=%d tick=%d", viewWrites, viewFault.load(), tick);
+    Log("CS2_MVP_FOV_END writes=%zu value=%.6f min=%.6f max=%.6f", fovWrites, lastFov, minimumFov, maximumFov);
+    motionTrack.End();
+    viewHoldAfterEnd=retainView && motionTrack.Applied()>0;
+    if (!viewHoldAfterEnd) viewOwnerThread=0;
+    if (viewHoldAfterEnd) Log("CS2_MVP_VIEW_HOLD tick=%d reason=%s",tick,reason);
+}
+
+// Expected preflight/readback failures must not enter Plat_FatalError's
+// blocking SDL dialog. Record failure, stop recording and leave the process.
+void AbortCaptureEnvironment(ISource2EngineToClient* engine,int tick,const char* phase,const std::string& error) {
+    Log("CS2_MVP_ENVIRONMENT_ERROR phase=%s %s",phase,error.c_str());
+    environmentTick=tick;environmentAbortRequested=true;
+    if(environmentRecording && engine)engine->ExecuteClientCmd(0,"endmovie",true);
+    environmentRecording=false;
+    EndCameraTrack(tick,"capture_error");
+    RequireRestoreCaptureEnvironment("capture_error");
+    isQuitting=true;demoPath=nullptr;
+    if(engine)engine->ExecuteClientCmd(0,"quit",true);
+}
